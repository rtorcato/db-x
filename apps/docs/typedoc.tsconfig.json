{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"paths": {
			"@db-x/runtime": ["../../packages/runtime/src/index.ts"],
			"@db-x/runtime/jsx-runtime": ["../../packages/runtime/src/jsx-runtime.ts"],
			"@db-x/postgres-library": ["../../packages/postgres-library/src/index.ts"]
		}
	},
	"include": [
		"../../packages/runtime/src/**/*.ts",
		"../../packages/runtime/src/**/*.tsx",
		"../../packages/postgres-library/src/**/*.ts",
		"../../packages/postgres-library/src/**/*.tsx"
	],
	"exclude": [
		"../../packages/*/src/**/*.test.ts",
		"../../packages/*/src/**/*.test.tsx",
		"../../packages/*/src/**/*.spec.ts",
		"../../packages/*/src/**/*.spec.tsx",
		"../../packages/*/dist",
		"../../packages/*/node_modules",
		"../../OLD",
		"../../apps/dashboard",
		"../../examples"
	]
}
