# Connection settings for the dbx-demo CockroachDB todos schema.
# Copy this file to `.env` to override; .env is gitignored.
#
# Defaults target the local single-node CockroachDB in docker-compose.yml
# (insecure mode). CockroachDB speaks the Postgres wire protocol, so it
# connects through @db-x/postgres-library with no new library.

# CockroachDB connection. Insecure single-node has NO password for `root`;
# the value below is a dummy that the server ignores — it exists only because
# <Postgres> requires a non-empty password. (Use a real password on a secure
# cluster / CockroachDB Cloud.)
TODOS_DB_USER=root
TODOS_DB_PASSWORD=root
TODOS_DB_NAME=todos

# Host + port. CockroachDB's SQL port is 26257 (not Postgres's 5432).
TODOS_DB_HOST=localhost
TODOS_DB_PORT=26257

# Full connection URL. Overrides host/port/user/password above when set.
# CockroachDB Cloud: paste the connection string from the console (keeps sslmode).
# DATABASE_URL=postgres://root:root@localhost:26257/todos
