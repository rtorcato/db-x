# Connection settings for the dbx-demo Supabase todos schema.
# Copy this file to `.env` to override; .env is gitignored.
#
# Defaults target a local Supabase stack started with `supabase start`
# (Supabase CLI + Docker). That stack exposes Postgres on 127.0.0.1:54322
# as the `postgres` superuser (password `postgres`), with the `auth` schema
# and `auth.users` already provisioned — which this schema references.

# Supabase Postgres connection (the `postgres` role owns the schema).
TODOS_DB_USER=postgres
TODOS_DB_PASSWORD=postgres
TODOS_DB_NAME=postgres

# Host + port. Local `supabase start` defaults shown here.
# For a hosted project, use the direct connection (port 5432) from
# Project Settings → Database, or set DATABASE_URL below.
TODOS_DB_HOST=127.0.0.1
TODOS_DB_PORT=54322

# Full connection URL. Overrides host/port/user/password above when set.
# Hosted Supabase: copy the "Direct connection" string from the dashboard.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
