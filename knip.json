{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["apps/docs"],
  "ignoreUnresolved": ["^\\.$"],
  "rules": { "duplicates": "off" },
  "workspaces": {
    "packages/*": {
      "entry": "src/index.{ts,tsx}",
      "project": "src/**/*.{ts,tsx}"
    },
    "examples/*": {
      "entry": "dbx.tsx",
      "project": "**/*.{ts,tsx}"
    }
  }
}
