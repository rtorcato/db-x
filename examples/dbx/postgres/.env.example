# Connection settings for the dbx-demo todos schema.
# Copy this file to `.env` to override; .env is gitignored.
#
# All values are optional — dbx.tsx falls back to the same defaults
# shown here if a variable isn't set, so the demo runs out of the box.

# Postgres credentials (TODOS_PG in dbx.tsx).
# Also used by infra.tsx as POSTGRES_USER / PASSWORD / DB on the <Service>.
TODOS_DB_USER=todos
TODOS_DB_PASSWORD=todos
TODOS_DB_NAME=todos

# Host + port for the standalone DB-X demo (dbx.tsx <DatabaseTarget>).
# Ignored when DATABASE_URL below is set explicitly.
TODOS_DB_HOST=localhost
TODOS_DB_PORT=5432

# Full connection URL. Overrides host/port/user/password above when set.
# Leave commented to auto-build from the parts.
# DATABASE_URL=postgres://todos:todos@localhost:5432/todos

# Password for the read-only DbUser created by <TodosSchema>.
READONLY_PASSWORD=readonly

# pgAdmin web UI (http://localhost:5050)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
