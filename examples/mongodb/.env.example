# Connection settings for the dbx-demo todos schema on MongoDB.
# Copy this file to `.env` to override; .env is gitignored. dbx.tsx copies it
# for you on first run.

# Database the schema is applied to (<Mongo database>).
TODOS_DB_NAME=todos

# Credentials for the local docker single node (see docker-compose.yml).
# Authentication is against the `admin` database — hence ?authSource=admin.
TODOS_DB_USER=todos
TODOS_DB_PASSWORD=todos
TODOS_DB_HOST=localhost
TODOS_DB_PORT=27017

# Full connection URI. Overrides every part above when set — use this for
# Atlas. Leave commented to auto-build from the parts.
#
# Note: mongosh has no PGPASSWORD equivalent, so this URI is passed on the
# command line and is visible in `ps` while a command runs. DB-X masks it in
# its own logs. On a shared host prefer X.509 / AWS IAM auth.
# MONGODB_URL=mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true
