{
  "name": "db-x",
  "version": "0.1.0-alpha.0",
  "description": "Production-grade database schema deployment with the ergonomics of a JSX component.",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rimraf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "typecheck": "tsc -b",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "knip": "knip",
    "prepare": "husky",
    "verify": "pnpm -r --filter='./packages/*' build && pnpm -r test:run && biome check . && (js-tooling doctor || true)",
    "doctor": "js-tooling doctor"
  },
  "devDependencies": {
    "@rtorcato/js-tooling": "latest",
    "knip": "^6.0.0",
    "typescript": "^5.9.3",
    "@types/node": "^26.0.1",
    "@biomejs/biome": "^2.5.1",
    "vitest": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": "biome check --fix --no-errors-on-unmatched",
    "*.{json,md,yml,yaml}": "biome format --write --no-errors-on-unmatched"
  }
}
